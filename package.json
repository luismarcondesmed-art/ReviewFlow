{
  "name": "reviewflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && git push && npx vercel --prod",
    "login": "npx vercel login",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run desktop:check",
    "submit": "node scripts/autosubmit.mjs --once",
    "autosubmit": "node scripts/autosubmit.mjs",
    "desktop:check": "node --check desktop/main.cjs && node --test desktop/security.test.cjs",
    "desktop:dev": "npm run desktop:runtime && npm run build && electron .",
    "desktop:pack": "npm run desktop:runtime && npm run build && electron-builder --win --dir",
    "desktop:build": "npm run desktop:runtime && npm run build && electron-builder --win portable",
    "desktop:runtime": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vercel/analytics": "^1.1.2",
    "@vercel/speed-insights": "^1.0.9",
    "canvas-confetti": "^1.9.2",
    "firebase": "^12.7.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.562.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "glob": "^11.0.0",
    "rimraf": "^6.0.1",
    "tar": "^7.4.3"
  },
  "main": "desktop/main.cjs",
  "description": "Planejamento de estudos e revis\u00e3o espa\u00e7ada",
  "author": "ReviewFlow",
  "build": {
    "appId": "art.medmarcondes.reviewflow",
    "productName": "ReviewFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/security.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ReviewFlow-${version}-Windows.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
